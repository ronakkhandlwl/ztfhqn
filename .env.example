# Backend (all optional; defaults shown)
WINDDESK_DATA_SOURCE=snapshot          # snapshot | elexon (live fetch, falls back to snapshot)
WINDDESK_DECISION_START=2026-01-01     # first purchase-decision day
WINDDESK_DECISION_END=2026-01-31       # last purchase-decision day
WINDDESK_HISTORY_START=2025-12-01      # error history loaded before the first decision
WINDDESK_BAND_WINDOW_DAYS=28           # trailing window for walk-forward error bands
WINDDESK_CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Frontend
VITE_API_BASE=                          # empty = same origin (/api)
